{
  "name": "@quvantic/mcp-core",
  "version": "0.1.0",
  "description": "Shared auth, pagination, retries, errors, and redacted logging for Quvantic MCP connectors.",
  "type": "module",
  "license": "MIT",
  "author": "Mustafa (https://github.com/mustafaautomation)",
  "homepage": "https://mcp-connectors.quvantic.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaautomation/business-mcp-connectors.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mustafaautomation/business-mcp-connectors/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
