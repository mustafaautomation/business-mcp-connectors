# Sandbox is the default and needs no tokens. Set MCP_MODE=live to call vendor APIs.
MCP_MODE=sandbox

# Set to true, 1, or yes to refuse every write tool. Same as passing --read-only.
MCP_READ_ONLY=

# HubSpot private app token.
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.companies.read, crm.objects.companies.write,
# crm.objects.deals.read, crm.objects.deals.write.
# If the app settings list a separate notes scope, grant read and write for notes too.
HUBSPOT_ACCESS_TOKEN=

# ClickUp personal API token (Settings → Apps). The token carries that user's permissions.
CLICKUP_API_TOKEN=
# Required for list_lists unless CLICKUP_SPACE_ID is set.
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
# Required by the deal-won workflow in live mode.
CLICKUP_LIST_ID=

# Google OAuth access token with https://www.googleapis.com/auth/spreadsheets
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notion internal integration token. Share each page and database with the integration.
# Capabilities: Read content, Update content, Insert content.
NOTION_API_TOKEN=
